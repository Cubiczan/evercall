# ── AssemblyAI (REQUIRED) ─────────────────────────────────────────────
# Get your key: https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=

# ── Telephony (stretch goal — the demo runs browser-to-"phone") ──────
# Real PSTN calls to grandma's landline/mobile happen via Twilio Media
# Streams. Leave empty for the browser-only demo mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Scheduling ────────────────────────────────────────────────────────
# Daily call time in cron format (default: 10:00 local)
DAILY_CALL_CRON="0 10 * * *"

# ── Family alerts ─────────────────────────────────────────────────────
# Webhook (Slack/Discord/email relay) invoked when severity >= warning
FAMILY_ALERT_WEBHOOK_URL=
